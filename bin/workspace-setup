#!/usr/bin/env bash

set -euo pipefail

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$APP_ROOT"
# shellcheck source=../script/workspace-common.sh
source "$APP_ROOT/script/workspace-common.sh"

mode=linked
reseed=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --main) mode=main ;;
    --reseed) reseed=true ;;
    -h|--help)
      cat <<'USAGE'
Usage: bin/workspace-setup [--main] [--reseed]

Provision this linked worktree with isolated Lewp and Compose services.
Use --main only in the primary checkout to route it at reader.lewp.
Use --reseed to reset and seed only this workspace's development database.
USAGE
      exit 0
      ;;
    *) fail "unknown option: $1"; exit 2 ;;
  esac
  shift
done

checkout="$(physical_dir "$APP_ROOT")"
primary="$(primary_checkout)"
if [ "$mode" = main ]; then
  [ "$checkout" = "$primary" ] || fail "--main may only be used in the primary checkout"
  workspace=main
  app_host=reader.lewp
else
  [ "$checkout" != "$primary" ] || fail "the primary checkout requires explicit --main; localhost remains the default"
  workspace="$(basename "$checkout")"
  validate_workspace_name "$workspace"
  app_host="$workspace.reader.lewp"
fi
compose_project="lewp-reader-$workspace"

recovery_on_error() {
  local status=$?
  trap - ERR
  printf '\nWorkspace provisioning failed for %s. Partial resources were left in place for inspection and retry.\n' "$workspace" >&2
  print_recovery "$checkout" || true
  exit "$status"
}
trap recovery_on_error ERR

# A copied checkout must never retain another checkout's generated authority.
# Remove it before OS, Docker, dependency, or allocation failure points.
if [ -e "$WORKSPACE_IDENTITY_FILE" ]; then
  # Only a jq comparison may prove the identity inherited; a missing tool must
  # fail closed rather than delete this checkout's own teardown authority.
  command_exists jq || fail "required workspace tool is missing: jq"
  if ! jq -e --arg name "$workspace" --arg mode "$mode" --arg checkout "$checkout" \
      '.workspace_name == $name and .mode == $mode and .checkout_path == $checkout' \
      "$WORKSPACE_IDENTITY_FILE" >/dev/null 2>&1; then
    printf 'Removing inherited workspace identity before provisioning.\n' >&2
    rm -f "$WORKSPACE_IDENTITY_FILE" "$WORKSPACE_LEWP_FILE" "$WORKSPACE_MISE_FILE" "$WORKSPACE_SEED_MARKER"
  fi
fi

if [ "${WORKSPACE_ALLOW_UNSUPPORTED_OS:-0}" != 1 ] && [ "$(uname -s)" != Darwin ]; then
  fail "the Lewp workspace workflow currently supports macOS only"
fi

require_workspace_tools
assert_compose_owned_or_empty "$compose_project" "$checkout"

printf '== Installing locked dependencies ==\n'
bundle check >/dev/null 2>&1 || bundle install
npm ls --depth=0 >/dev/null 2>&1 || npm ci

write_identity() {
  local rails_port="${1:-}" vite_port="${2:-}" postgres_port="${3:-}" redis_port="${4:-}"
  local identity_tmp="$WORKSPACE_IDENTITY_FILE.tmp.$$"
  jq -n \
    --arg workspace_name "$workspace" \
    --arg mode "$mode" \
    --arg checkout_path "$checkout" \
    --arg compose_project "$compose_project" \
    --arg app_host "$app_host" \
    --arg rails_port "$rails_port" \
    --arg vite_port "$vite_port" \
    --arg postgres_port "$postgres_port" \
    --arg redis_port "$redis_port" \
    '{workspace_name:$workspace_name,mode:$mode,checkout_path:$checkout_path,compose_project:$compose_project,app_host:$app_host,rails_port:$rails_port,vite_port:$vite_port,postgres_port:$postgres_port,redis_port:$redis_port}' > "$identity_tmp"
  mv "$identity_tmp" "$WORKSPACE_IDENTITY_FILE"
}

printf '\n== Leasing workspace ports ==\n'
lewp init --force --host "$app_host" >/dev/null
# Establish local teardown authority before any allocation can fail partway.
write_identity
route_json="$(lewp lease --host "$app_host" --json)"
rails_port="$(printf '%s' "$route_json" | jq -er '.port')"
leased_host="$(printf '%s' "$route_json" | jq -er '.host')"
[ "$leased_host" = "$app_host" ] || fail "Lewp returned unexpected host '$leased_host'"
vite_port="$(lewp port --name vite --json | jq -er '.port')"
postgres_port="$(lewp port --name postgres --json | jq -er '.port')"
redis_port="$(lewp port --name redis --json | jq -er '.port')"
for port in "$rails_port" "$vite_port" "$postgres_port" "$redis_port"; do
  [[ "$port" =~ ^[0-9]+$ ]] || fail "Lewp returned a malformed port: $port"
done

write_identity "$rails_port" "$vite_port" "$postgres_port" "$redis_port"

checkout_toml="$(jq -Rn --arg value "$checkout" '$value')"
cat > "$WORKSPACE_MISE_FILE" <<EOF
# Generated by bin/workspace-setup. Do not copy between checkouts.
[env]
PORT = "$rails_port"
VITE_PORT = "$vite_port"
APP_HOST = "$app_host"
COMPOSE_PROJECT_NAME = "$compose_project"
POSTGRES_PORT = "$postgres_port"
REDIS_PORT = "$redis_port"
PGHOST = "127.0.0.1"
PGPORT = "$postgres_port"
PGUSER = "postgres"
REDIS_URL = "redis://127.0.0.1:$redis_port/0"
LEWP_READER_CHECKOUT_PATH = $checkout_toml
EOF

export PORT="$rails_port"
export VITE_PORT="$vite_port"
export APP_HOST="$app_host"
export COMPOSE_PROJECT_NAME="$compose_project"
export POSTGRES_PORT="$postgres_port"
export REDIS_PORT="$redis_port"
export PGHOST=127.0.0.1
export PGPORT="$postgres_port"
export PGUSER=postgres
export REDIS_URL="redis://127.0.0.1:$redis_port/0"
export LEWP_READER_CHECKOUT_PATH="$checkout"

mise trust "$WORKSPACE_MISE_FILE" >/dev/null
resolved_pgport="$(mise env --json | jq -er '.PGPORT')"
[ "$resolved_pgport" = "$postgres_port" ] || fail "Mise resolved PGPORT=$resolved_pgport, expected leased port $postgres_port. Activate Mise in your shell and retry."

printf '\n== Starting isolated PostgreSQL and Redis ==\n'
compose "$compose_project" up -d --wait
assert_compose_owned_or_empty "$compose_project" "$checkout"

printf '\n== Preparing workspace databases ==\n'
database_exists="$(compose "$compose_project" exec -T postgres psql -U postgres -d postgres -Atqc "SELECT 1 FROM pg_database WHERE datname = 'lewp_reader_development'" | tr -d '[:space:]')"
if [ "$reseed" = true ]; then
  rm -f "$WORKSPACE_SEED_MARKER"
  mise exec -- env RAILS_ENV=development bin/rails db:reset
  mkdir -p "$(dirname "$WORKSPACE_SEED_MARKER")"
  : > "$WORKSPACE_SEED_MARKER"
elif [ -f "$WORKSPACE_SEED_MARKER" ]; then
  mise exec -- env RAILS_ENV=development bin/rails db:prepare
elif [ "$database_exists" = 1 ]; then
  # A prior attempt created the database but did not finish seeding.
  mise exec -- env RAILS_ENV=development bin/rails db:migrate db:seed
  mkdir -p "$(dirname "$WORKSPACE_SEED_MARKER")"
  : > "$WORKSPACE_SEED_MARKER"
else
  # Rails db:prepare creates, migrates, and seeds a new database once.
  mise exec -- env RAILS_ENV=development bin/rails db:prepare
  mkdir -p "$(dirname "$WORKSPACE_SEED_MARKER")"
  : > "$WORKSPACE_SEED_MARKER"
fi
mise exec -- env RAILS_ENV=test bin/rails db:prepare

setup_herdr() {
  command_exists herdr || return 0
  [ -n "${HERDR_WORKSPACE_ID:-}" ] || return 0

  local marker list recorded existing created tmp
  marker="$(herdr_marker_path)"
  list="$(herdr workspace list)" || fail "Herdr is active but its workspace list could not be read"
  validate_herdr_list_json "$list" || fail "Herdr returned malformed workspace JSON"

  if [ -e "$marker" ] || [ -L "$marker" ]; then
    [ -f "$marker" ] && [ ! -L "$marker" ] || fail "Herdr marker must be a regular, non-symlink file: $marker"
    recorded="$(tr -d '\r\n' < "$marker")"
    [[ "$recorded" =~ ^w[[:alnum:]]+$ ]] || fail "invalid Herdr workspace marker: $marker"
    if jq -e --arg id "$recorded" '.result.workspaces[] | select(.workspace_id == $id)' <<<"$list" >/dev/null; then
      jq -e --arg id "$recorded" --arg path "$checkout" \
        '.result.workspaces[] | select(.workspace_id == $id and .worktree.checkout_path == $path)' \
        <<<"$list" >/dev/null || fail "recorded Herdr workspace $recorded belongs to another checkout"
      herdr workspace focus "$recorded" >/dev/null || fail "could not focus recorded Herdr workspace $recorded"
      return 0
    fi
    rm -f "$marker"
  fi

  existing="$(jq -er --arg path "$checkout" '.result.workspaces[] | select(.worktree.checkout_path == $path) | .workspace_id' <<<"$list" | head -1 || true)"
  if [ -n "$existing" ]; then
    recorded="$existing"
    [[ "$recorded" =~ ^w[[:alnum:]]+$ ]] || fail "Herdr returned malformed workspace identifier '$recorded'"
    herdr workspace focus "$recorded" >/dev/null || fail "could not focus Herdr workspace $recorded"
  else
    created="$(herdr workspace create --cwd "$checkout" --label "$workspace" --focus)" || fail "could not create Herdr workspace"
    if ! recorded="$(jq -er '.result.workspace.workspace_id | select(type == "string")' <<<"$created")"; then
      printf 'Herdr may have created an unrecorded workspace. Inspect with `herdr workspace list` and close only the workspace for %q.\n' "$checkout" >&2
      fail "Herdr returned an unexpected create response"
    fi
  fi
  [[ "$recorded" =~ ^w[[:alnum:]]+$ ]] || fail "Herdr returned malformed workspace identifier '$recorded'"
  tmp="$marker.tmp.$$"
  if ! printf '%s\n' "$recorded" > "$tmp" || ! mv "$tmp" "$marker"; then
    rm -f "$tmp"
    printf 'Herdr workspace %s may be orphaned. Inspect with `herdr workspace list` and close that exact identifier if it belongs to %q.\n' "$recorded" "$checkout" >&2
    fail "could not persist the Herdr marker beside the Git worktree metadata"
  fi
}

setup_herdr
trap - ERR
printf '\nWorkspace %s is ready.\n' "$workspace"
printf '  URL: https://%s\n' "$app_host"
printf '  Verify: mise env --json | jq -r .PGPORT\n'
printf '  Start: bin/dev\n'
